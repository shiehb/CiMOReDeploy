# Copy this file to .env and fill in all values before deploying to production.
# When DEBUG=True these are optional — settings.py has safe dev defaults.
# When DEBUG=False every variable below is REQUIRED.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=your-secret-key-here

# ---------------------------------------------------------------------------
# Hosts & CORS  (comma-separated, no spaces)
# ---------------------------------------------------------------------------
ALLOWED_HOSTS=cimoredeploy.onrender.com,cimore.vercel.app
CORS_ALLOWED_ORIGINS=https://cimore.vercel.app,https://cimoredeploy.onrender.com
CSRF_TRUSTED_ORIGINS=https://cimore.vercel.app,https://cimoredeploy.onrender.com
FRONTEND_URL=https://cimore.vercel.app

# ---------------------------------------------------------------------------
# Database (Supabase / PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Email — Gmail API
# ---------------------------------------------------------------------------
GMAIL_API_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_API_CLIENT_SECRET=your-client-secret
GMAIL_API_REFRESH_TOKEN=your-refresh-token
EMAIL_HOST_USER=your-gmail@gmail.com
DEFAULT_FROM_EMAIL=CiMORe <your-gmail@gmail.com>
